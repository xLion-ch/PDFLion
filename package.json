{
  "name": "pdflion",
  "productName": "PDFLion",
  "version": "0.1.0",
  "description": "A PDF viewer for macOS, Windows and Linux, built on pdf.js",
  "author": "xLion-ch <181110832+xLion-ch@users.noreply.github.com>",
  "desktopName": "io.github.xlion-ch.pdflion.desktop",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node scripts/update-pdfjs.js --build-if-missing",
    "start": "electron .",
    "pdfjs:check": "node scripts/update-pdfjs.js --check",
    "pdfjs:update": "node scripts/update-pdfjs.js",
    "pdfjs:build": "node scripts/update-pdfjs.js --build",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js",
    "build": "node scripts/build.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "electron-updater": "6.8.11"
  }
}
